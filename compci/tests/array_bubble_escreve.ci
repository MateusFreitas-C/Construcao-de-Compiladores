var a[8];
var n = 8;
var i = 0;
var j = 0;
var tmp = 0;
main {
  i = 0;
  while i < n {
    a[i] = (i * 37 + 11) % 50;
    i = i + 1;
  }
  escreve 0 - 1;
  i = 0;
  while i < n {
    escreve a[i];
    i = i + 1;
  }
  i = 0;
  while i < n - 1 {
    j = 0;
    while j < n - 1 - i {
      if a[j] > a[j + 1] {
        tmp = a[j];
        a[j] = a[j + 1];
        a[j + 1] = tmp;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  escreve 0 - 2;
  i = 0;
  while i < n {
    escreve a[i];
    i = i + 1;
  }
  return a[0];
}
