t = 0;
{
  if 3 < 4 { t = t + 1; }
  if 4 < 3 { t = t + 100; }
  if 4 > 3 { t = t + 1; }
  if 3 > 4 { t = t + 100; }
  if 3 <= 3 { t = t + 1; }
  if 4 <= 3 { t = t + 100; }
  if 3 >= 3 { t = t + 1; }
  if 3 >= 4 { t = t + 100; }
  if 3 == 3 { t = t + 1; }
  if 3 == 4 { t = t + 100; }
  if 3 != 4 { t = t + 1; }
  if 3 != 3 { t = t + 100; }
  return t;
}
